# Copy to `.env` and fill in. Never commit the real .env.

# REQUIRED: a long random secret. Generate with:  openssl rand -hex 32
# Pinning this keeps user sessions valid across restarts.
SECRET_KEY=replace-with-openssl-rand-hex-32

# Database (MariaDB/MySQL) — change the passwords.
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_USER=ctfd
MARIADB_PASSWORD=change-me
MARIADB_DATABASE=ctfd

# Gunicorn workers (rule of thumb: CPU cores). gevent worker class.
WORKERS=2

# Your public hostname (used by nginx example).
SITE_DOMAIN=ctf.example.com
